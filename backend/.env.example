# Copy this file to ".env" and fill in your values.
PORT=3000

# Your GitHub Pages address (so the browser is allowed to call this backend). Leave empty to allow all.
ALLOWED_ORIGIN=

# Email sending (optional). Without it, messages are still saved in backend/data/messages.json
# For Gmail: enable 2-step verification, then create an "App password" and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=shujjol27@gmail.com
SMTP_PASS=
MAIL_TO=shujjol27@gmail.com
